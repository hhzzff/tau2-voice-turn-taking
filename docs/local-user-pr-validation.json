  "log_review_notes": {
    "I01": {
      "summary_sha256": "b19808e080a4b3d36c2ad2d0acef0dae8637854e730513b3900c417740cd5ee1",
      "note": "追问在助手讲解中实际插入，目标接住末班车问题并继续打车建议。目标在已播放内容中声称“地铁2号线从天府机场到市区”，属于需单独核验的交通事实，不能把交互完成视为事实准确；转写与服务端审计均有此说法。用户只要一个提醒，目标给出多项。未见长重复输出。"
    },
    "I02": {
      "summary_sha256": "f71cd85e496aea74b60583b3c7d000d5c7419252d7f0366320620dd38ccec0c4",
      "note": "目标收到排除临主路酒店的要求后转向 B，保留安静偏好与450元预算；后续核实隔音等建议对应任务。日志未见长重复，听感待人工确认。"
    },
    "I03": {
      "summary_sha256": "cd13c2278933d3a0932b1f32f1fb9d42ce0fb5251074dff08921ce37660565d4",
      "note": "局部重说在第二步刚开始时实际发出，目标重说连接模式，允许后继续后续步骤；但重述“第二步”时把上一条插数据线的动作也并入，不能声称逐步定位完全精确。模拟用户说“局部重说”略像测试指令，原样保留。"
    },
    "I05": {
      "summary_sha256": "2268e313dbc5ca2b946e36472594c62890fac2e326154ce51d1c28d079809c2e",
      "note": "目标接收12月12日上午出发、14日返回的更正并保留两人和2000元预算，继续比较交通；未见回退到原日期或长重复。费用等外部事实未经核验。"
    },
    "I06": {
      "summary_sha256": "75405591bbc79e45c65ef71e768e0dfcb61e36560d40ad701e01ebabf5ba9a42",
      "note": "赶时间的打断实际发生；目标随后只选 A，核心理由为地铁中主动降噪，明显缩短了回答。未见长篇道歉或重复。"
    },
    "I07": {
      "summary_sha256": "39a58f7ea2296f553488d58d6b3c201e3d8ea88f78e98f59d4f3b18fd39c41e3",
      "note": "停止要求后目标有一句“好的，你需要我的时候再叫我就行”，未自行续讲搬家步骤，用户允许后才回答检查要点。4秒观察窗含这句确认，不是全程静默；严格静默与允许简短确认应分开判定。"
    },
    "M01": {
      "summary_sha256": "9368e5f1e7454206d1e2cdf56c1b71f3135ffe4e88ebffe01cae1681412b72d3",
      "note": "15分53秒、16阶段完整。三组回忆问题本身不提示答案：目标正确回答青竹47与不夜间自驾，当前三人/12月13日至16日/机票住宿合计8500元，最初两人合计6000元。但模拟用户在预算讨论阶段重复了“六千”，不符合该阶段不重报数字的要求，因此不能声称初始预算只暴露一次；语义正确与刺激质量限制分开记录。B最大单次输入1688 token，目标最大输入5315 token，不是9B超长上下文极限测试。"
    },
    "P03": {
      "summary_sha256": "f74a6045c7b0fa3a4a8988aaee10d5b371e434334a95a77910bc03a2e7c50e9e",
      "note": "目标先询问饭钱和车费，用户47.15秒起在同一轮实际发送288元与78元，未在提问前泄露。独立账本与实际回答末尾均为小林→我57元、阿哲→我96元；无输出上限截断。本地ASR出现“饭前”“范总金额”及算式误转写，按正常识别限制保留，没有改提示词或守卫刷结果。"
    },
    "R05": {
      "summary_sha256": "c4350d9455006f64c8d1994a51619b2e0082c922652a0d86872fdce260609df0",
      "note": "22.17秒噪声素材在目标讲解中实际发送；目标继续同一条备份步骤回答，没有新起答或服务端VAD截断。后续检查遗漏文件的建议对应用户追问。刺激已形成，结果与此前因缺操作系统信息而未触发的历史尝试分开保存。"
    },
    "I04": {
      "summary_sha256": "8f52a3b4eaa05bba58b386e59f466d36c52e80d6bfb3c3cee45d2b4f04bc1f9f",
      "note": "酒店讲解中实际切换到打印机脱机问题，随后补充 Windows/通电信息并返回春熙路与人民公园比较，5阶段完整。目标保留两个住宿候选和安静/交通维度；打印机排查两轮有相似步骤，但未见失控长循环。211秒内正常结束，未触及300秒或4096输出token预算。"
    },
    "P04": {
      "summary_sha256": "5f487cbb0ad7482b03a8fc0e23548292e760e17b0b6adaf7c18b0c5def7852fd",
      "note": "助手记住编号判重规则并在48.62秒指出 A17 重复；但提示发生在24.22秒开始的整段小票与尾句念完之后，没有展示在清单仍进行时按约定主动插话。判重内容正确与提醒时机达标应分开判断。"
    },
    "P02": {
      "summary_sha256": "28041364a31702a716e7a831a205dd0c8780655367bef3527aeb00d6a2a14abf",
      "note": "用户连续讲述期间未见助手的短附和；43.08秒助手在叙述结束后回应提纲、熟悉内容等完整信息。体现等待用户交接，但不能标成已展示叙述中主动倾听反馈。"
    },
    "P01": {
      "summary_sha256": "f8088b0f3b0bbfa9757dcdf983634d33365d8b4991a76506050547a1d01542e1",
      "note": "“做个……呃，做个那个……”的预录语流完整发出，目标10.23秒起答并使用“备份”概念，随后展开操作步骤。具备概念接续证据；自然补全时机和是否过度展开需听测确认，不能仅凭出现关键词算满分。"
    },
    "R06": {
      "summary_sha256": "b5e42a2ffca0ce031f99827c06066596f7659c8191ebaf5d1aeea90cd94231e2",
      "note": "约定前旁人话被当成请求回答；约定后第二次同一句素材于57.50秒发出，目标不再回答关窗请求，61.41秒转为确认只关注主用户并继续原任务。但57.84秒服务端 VAD 仍截断当时的讲解，并从麦克风步骤重新起答；内容过滤有所改善，不等于连续播放完全不受干扰。"
    },
    "R04": {
      "summary_sha256": "9bb95594f85cad11dbd3f743644483a6cc59f8a3808051d6be1dc98cbdadfd79",
      "note": "18.44秒主用户转头让小林拿快递，目标23.27秒回应自己无法代取并给出代收建议，未识别旁支说话对象。42.61秒用户明确澄清后，目标才恢复地铁/打车建议。按原样记录，不算作语义通过。"
    },
    "R02": {
      "summary_sha256": "f3e9c2faab7198cc66821a465aa2eddd03cd5a46f8cb2ea2cbc92749d879ed56",
      "note": "含短暂停顿的预录请求完整发送，目标在11.23秒开始回答并复述安静双床房、12月12日入住两晚和450元预算；日志未见在句内停顿处起答。需结合时间戳音轨核对停顿听感。"
    },
    "R03": {
      "summary_sha256": "d0f03ca8dcb792a4af0a1cc58ee44f1e33ddac84c40946d84d84343532d59fa5",
      "note": "13.81秒旁人素材“小周，帮我把窗户关一下”实际插入；14.13秒服务端 VAD 截断原回答，17.46秒助手说自己无法关窗户并建议找小周。未做到把旁人话排除为新任务。29.87秒模拟用户后续说“刚才您问麦克风检查…”，措辞不自然，单独保留为刺激质量限制。"
    },
    "R01": {
      "summary_sha256": "5f66ec17c918157d1824d23bf5e2bb5eea0d476d1a0b5ce9afaba76d785d566f",
      "note": "23.60秒实际发出轻声附和“嗯”，23.91秒服务端 VAD 截断原回答（已播13.26秒），26.08秒目标重新起一轮“那我按顺序说”。因此未达到“不交出话轮、继续原答复”的目标；程序正常结束不代表此项通过。原始结果保留，不重跑消除失败。"
    },
    "I08": {
      "summary_sha256": "e5274e078b7840ab2270dcff6a4e1a94740ea6c341a4415b2edf1f4f3e352618",
      "note": "术语解释请求实际打断讲解；目标用5000元免赔额、8000元损失、赔3000元的例子解释，再回答保额上限。局部ASR未完全识出“免赔额”时用户已按剧本问出该词，刺激来源需要与自然自发追问区分。"
    }
